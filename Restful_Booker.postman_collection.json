		{
			"name": "GETbooking",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// 1. חישוב תאריך צ'ק-אין (מחר)\r",
							"const today = new Date();\r",
							"const checkin = new Date();\r",
							"checkin.setDate(today.getDate() + 1);\r",
							"const checkinDate = checkin.toISOString().split('T')[0];\r",
							"\r",
							"// 2. חישוב תאריך צ'ק-אאוט (מחר + 3 ימים)\r",
							"const checkout = new Date();\r",
							"checkout.setDate(checkin.getDate() + 3);\r",
							"const checkoutDate = checkout.toISOString().split('T')[0];\r",
							"\r",
							"// 3. שמירת התאריכים כמשתנים דינמיים בפוסטמן\r",
							"pm.environment.set(\"dynamic_checkin\", checkinDate);\r",
							"pm.environment.set(\"dynamic_checkout\", checkoutDate);\r",
							"pm.environment.set(\"calculated_price\", 300);\r",
							""
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"const response = pm.response.json();\r",
							"\r",
							"pm.test(\"Response is not empty\", function () {\r",
							"    pm.expect(response).to.not.be.empty;\r",
							"});\r",
							"\r",
							"pm.test(\"Firstname exists\", function () {\r",
							"    pm.expect(response.firstname).to.exist;\r",
							"});\r",
							"\r",
							"pm.test(\"Lastname exists\", function () {\r",
							"    pm.expect(response.lastname).to.exist;\r",
							"});\r",
							"\r",
							"pm.test(\"Total price is numeric\", function () {\r",
							"    pm.expect(response.totalprice).to.be.a(\"number\");\r",
							"});\r",
							"\r",
							"pm.test(\"Deposit paid is boolean\", function () {\r",
							"    pm.expect(response.depositpaid).to.be.a(\"boolean\");\r",
							"});\r",
							"\r",
							"pm.test(\"Check-in date exists\", function () {\r",
							"    pm.expect(response.bookingdates.checkin).to.exist;\r",
							"});\r",
							"\r",
							"pm.test(\"Check-out date exists\", function () {\r",
							"    pm.expect(response.bookingdates.checkout).to.exist;\r",
							"});\r",
							"\r",
							"pm.test(\"Status code is 404\", function () {\r",
							"    pm.response.to.have.status(404);\r",
							"});\r",
							"\r",
							"pm.test(\"Error message is correct\", function () {\r",
							"    pm.expect(response.error).to.eql(\"Booking not found\");\r",
							"});"
						],
						"type": "text/javascript"
					}
				}
