{
	"info": {
		"_postman_id": "0699e32d-f768-49cd-bd86-db8ffc059e15",
		"name": "Restful Booker",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "greatebooking",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// 1. Рассчитываем дату заезда (Завтра)\r",
							"const today = new Date();\r",
							"const checkin = new Date();\r",
							"checkin.setDate(today.getDate() + 1);\r",
							"const checkinDate = checkin.toISOString().split('T')[0];\r",
							"\r",
							"// 2. Рассчитываем дату выезда (Завтра + 3 дня = 3 ночи)\r",
							"const checkout = new Date();\r",
							"checkout.setDate(checkin.getDate() + 3);\r",
							"const checkoutDate = checkout.toISOString().split('T')[0];\r",
							"\r",
							"// 3. Сохраняем динамические даты в переменные окружения\r",
							"pm.environment.set(\"dynamic_checkin\", checkinDate);\r",
							"pm.environment.set(\"dynamic_checkout\", checkoutDate);\r",
							"\r",
							"// 4. Расчет цены: 3 ночи * 100 шек. = 300 шек.\r",
							"pm.environment.set(\"calculated_price\", 300);\r",
							"\r",
							"console.log('base_url=[' + pm.environment.get('base_url') + ']');\r",
							"\r",
							"console.log(\r",
							"  \"request=\",\r",
							"  JSON.stringify(pm.request.url.toString())\r",
							");\r",
							"\r",
							"pm.variables.set(\r",
							"  \"booking_url\",\r",
							"  pm.environment.get(\"base_url\") + \"/booking\"\r",
							");"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Проверяем статус-код ответа\r",
							"pm.test(\"Status code is 200 OK - CreateBooking Success\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"var responseBody = pm.response.json();\r",
							"\r",
							"// Извлекаем сгенерированный ID и сохраняем его автоматически\r",
							"pm.test(\"Verify and save dynamic Booking ID\", function () {\r",
							"    pm.expect(responseBody.bookingid).to.be.a('number');\r",
							"    pm.environment.set(\"saved_booking_id\", responseBody.bookingid);\r",
							"});\r",
							"\r",
							"// Negative tests\r",
							"pm.test(\"Status code is 400\", function () {\r",
							"    pm.response.to.have.status(400);\r",
							"});\r",
							"\r",
							"pm.test(\"Status code is 401\", function () {\r",
							"    pm.response.to.have.status(401);\r",
							"});\r",
							"\r",
							"pm.test(\"Status code is 403\", function () {\r",
							"    pm.response.to.have.status(403);\r",
							"});\r",
							"\r",
							"pm.test(\"Status code is 404\", function () {\r",
							"    pm.response.to.have.status(404);\r",
							"});\r",
							"\r",
							"pm.test(\"Status code is 405\", function () {\r",
							"    pm.response.to.have.status(405);\r",
							"});\r",
							"\r",
							"pm.test(\"Status code is 415\", function () {\r",
							"    pm.response.to.have.status(415);\r",
							"});\r",
							"\r",
							"pm.test(\"Status code is 429\", function () {\r",
							"    pm.response.to.have.status(429);\r",
							"});\r",
							"\r",
							"pm.test(\"Status code is 500\", function () {\r",
							"    pm.response.to.have.status(500);\r",
							"});\r",
							"\r",
							"pm.test(\"Status code is 503\", function () {\r",
							"    pm.response.to.have.status(503);\r",
							"});"
						],
						"type": "text/javascript"
					}
				}
